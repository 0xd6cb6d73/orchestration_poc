# Use this as a reference for variables to export in your shell. Docker Compose
# also reads a repository-root .env file automatically; the Python application
# deliberately does not load or persist one.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional provider endpoint overrides. OPENAI_BASE_URL also supports
# OpenAI-compatible services such as OpenRouter or a local gateway.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_BASE_URL=
