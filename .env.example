# Docker Compose and the evaluation suite CLI read .env automatically.
# The evaluation CLI preserves exported variables over .env values.
# The application and legacy evaluation commands still require exported variables.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional provider endpoint overrides. OPENAI_BASE_URL also supports
# OpenAI-compatible services such as OpenRouter or a local gateway.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_BASE_URL=

# Evaluation suite: use OPENAI_API_KEY for the OpenRouter key when selecting this endpoint.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# PHOENIX_ENABLED=1
# PHOENIX_BASE_URL=http://localhost:6006
# PHOENIX_OTLP_HTTP_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_API_KEY=
